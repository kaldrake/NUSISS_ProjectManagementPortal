# /opt/portal/.env on EC2 #4 "scan"
AWS_REGION=ap-southeast-2
ECR_REGISTRY=325866321038.dkr.ecr.ap-southeast-2.amazonaws.com
ECR_REPOSITORY=nusiss_projectmanagementportal

DB_HOST=project-portal-mysql.cf44424gah0r.ap-southeast-2.rds.amazonaws.com
SCAN_DB_PASSWORD=

# SonarQube on the web EC2 (Route 53 private name)
SONAR_HOST_URL=http://web.portal.internal:9001
# SonarQube User Token (squ_...)
SONAR_TOKEN=
# AI fix suggestions: gemini, deepseek or claude (key needed for the chosen one)
AI_PROVIDER=deepseek
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=
GITHUB_TOKEN=

# Must be identical on the login, project and scan EC2s
JWT_SECRET=
JWT_EXPIRATION=86400000
