# Copy to /opt/portal/.env on the EC2 and fill in. Never commit the real file.
# Avoid single quotes (') in passwords - they are embedded in SQL by scripts/init-rds.sh.

AWS_REGION=ap-southeast-2
# <account-id>.dkr.ecr.ap-southeast-2.amazonaws.com
ECR_REGISTRY=
ECR_REPOSITORY=nusiss_projectmanagementportal

# Amazon RDS MySQL (values printed by aws/provision-rds.sh)
DB_HOST=
DB_MASTER_USER=admin
DB_MASTER_PASSWORD=

# Per-service database passwords (generate with: openssl rand -hex 16)
LOGIN_DB_PASSWORD=
PROJECT_DB_PASSWORD=
SCAN_DB_PASSWORD=
SONAR_DB_PASSWORD=

# Base64-encoded HMAC key shared by all three services (generate with: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Generate in the SonarQube UI (http://<ec2-ip>:9001 > My Account > Security) after first boot
SONAR_TOKEN=
DEEPSEEK_API_KEY=
GITHUB_TOKEN=
