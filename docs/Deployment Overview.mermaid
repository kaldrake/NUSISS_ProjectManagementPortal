flowchart LR
    User["👤 User"]

    subgraph WEB["web EC2 (single host)"]
        Caddy["🔒 Caddy<br>HTTPS :443"]
        Nginx["🌐 Nginx<br>frontend + /api proxy"]
        SQ["📊 SonarQube<br>:9001"]
    end

    ALB["⚖️ Internal ALB<br>:8081 :8082 :8083<br>/health"]

    subgraph ASG["Auto Scaling groups"]
        L["🔐 Login<br>:8081<br>1 to 3"]
        P["📁 Project<br>:8082<br>1 to 3"]
        S["🔍 Scan<br>:8083<br>1 to 3"]
    end

    RDS[("🗄️ RDS MySQL 8.4<br>login_db<br>project_db<br>scan_db")]
    GH["🐙 GitHub"]
    LLM["🤖 Gemini or<br>DeepSeek"]

    User --> Caddy --> Nginx --> ALB
    ALB --> L
    ALB --> P
    ALB --> S
    L --> RDS
    P --> RDS
    S --> RDS
    S --> SQ
    S --> GH
    S --> LLM

