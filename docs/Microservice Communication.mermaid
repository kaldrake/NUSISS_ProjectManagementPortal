%%{init: {'theme': 'default', 'themeVariables': {'lineColor': '#000000', 'edgeLabelBackground': '#ffffff'}}}%%
graph LR
    FE["🌐 Frontend<br>React + TypeScript<br>:3000"]

    subgraph "Backend Microservices"
        LS["🔐 Login Service<br>:8081<br><br>• POST /api/auth/register<br>• POST /api/auth/login<br>• POST /api/auth/logout (revokes the session)<br>• GET  /api/auth/me"]
        PS["📁 Project Service<br>:8082<br><br>• CRUD /api/projects (owner only)<br>• GET/POST /api/projects/{id}/repositories<br>• DELETE /api/projects/{id}/repositories/{rId}<br>• POST /api/projects/{id}/repositories/{rId}/scan<br>• GET  /api/projects/{id}/dashboard"]
        SCS["🔍 Scan Service<br>:8083 (results scoped to the JWT user)<br><br>• POST /api/scans/analyze (202)<br>• GET  /api/scans/{scanId}/status<br>• GET  /api/scans/repositories/{rId}/history<br>• GET  /api/scans/projects/{id}/vulnerabilities<br>• GET/PATCH /api/scans/vulnerabilities/{id}[/status]<br>• POST /api/scans/vulnerabilities/{id}/suggestion/regenerate<br>• GET  /api/scans/dashboard/projects/{id}/summary"]
    end

    subgraph "Databases (Amazon RDS MySQL)"
        LDB[("login_db<br>users")]
        PDB[("project_db<br>projects<br>repositories")]
        SDB[("scan_db<br>scans<br>vulnerabilities<br>ai_suggestions<br>scan_summary")]
    end

    subgraph "External Services"
        GH["🐙 GitHub<br>REST API + git clone"]
        SQ["📊 SonarQube<br>:9001<br>Static analysis"]
        AI["🤖 AI Suggestion Router<br>Gemini or DeepSeek (Claude supported) via AI_PROVIDER<br>call 1 generates the fix, call 2 scores it"]
    end

    %% Frontend → all services
    FE -->|"Bearer JWT"| LS
    FE -->|"Bearer JWT"| PS
    FE -->|"Bearer JWT"| SCS
    FE -->|"GET /repos/{owner}/{repo}<br>(validate repo when adding)"| GH

    %% Service-to-service (internal HTTP)
    PS -->|"POST /api/scans/analyze<br>(async, forwards the caller's JWT)"| SCS

    %% Services → their DBs
    LS --- LDB
    PS --- PDB
    SCS --- SDB

    %% External integrations
    SCS -->|"git clone"| GH
    SCS -->|"sonar-scanner CLI<br>+ REST API (poll + fetch issues)"| SQ
    SCS -->|"AI fix-suggestion request"| AI

    %% Styling
    style FE fill:#4CAF50,color:#fff
    style LS fill:#2196F3,color:#fff
    style PS fill:#2196F3,color:#fff
    style SCS fill:#2196F3,color:#fff
    style LDB fill:#FF9800,color:#fff
    style PDB fill:#FF9800,color:#fff
    style SDB fill:#FF9800,color:#fff
    style GH fill:#24292e,color:#fff
    style SQ fill:#9C27B0,color:#fff
    style AI fill:#333,color:#fff
