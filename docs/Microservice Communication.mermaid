%%{init: {'theme': 'dark', 'themeVariables': {'lineColor': '#000000', 'edgeLabelBackground': '#ffffff'}}}%%
graph TD
    FE["🌐 Frontend<br>React + TypeScript<br>:3000"]

    subgraph "Backend Microservices"
        LS["🔐 Login Service<br>:8081<br><br>• POST /api/auth/register<br>• POST /api/auth/login<br>• GET  /api/users/{id}"]
        PS["📁 Project Service<br>:8082<br><br>• CRUD /api/projects<br>• CRUD /api/projects/{id}/repositories<br>• POST /api/projects/{id}/repositories/{rId}/scan<br>• GET  /api/dashboard/summary"]
        SCS["🔍 Scan Service<br>:8083<br><br>• POST /api/scans/trigger<br>• GET  /api/scans/{repoId}/latest<br>• GET  /api/scans/{scanId}/vulnerabilities<br>• GET  /api/scans/{scanId}/ai-suggestions"]
    end

    subgraph "Databases"
        LDB[("login_db<br>users<br>sessions")]
        PDB[("project_db<br>projects<br>repositories")]
        SDB[("scan_db<br>scans<br>vulnerabilities<br>ai_suggestions<br>scan_summary")]
    end

    subgraph "External Services"
        GH["🐙 GitHub API<br>Repo metadata + Git clone"]
        SQ["📊 SonarQube<br>:9001<br>Static analysis"]
        AI["🤖 AI Suggestion Router<br>Gemini (active) · DeepSeek/Claude (standby)"]
    end

    %% Frontend → all services
    FE -->|"Bearer JWT"| LS
    FE -->|"Bearer JWT + X-User-Id"| PS
    FE -->|"Bearer JWT"| SCS

    %% Service-to-service (internal HTTP)
    PS -->|"GET /api/users/{id}<br>(validate token owner)"| LS
    PS -->|"POST /api/scans/trigger<br>(delegate scan job)"| SCS

    %% Services → their DBs
    LS --- LDB
    PS --- PDB
    SCS --- SDB

    %% External integrations
    PS -->|"GitHub REST API<br>(repo search & metadata)"| GH
    SCS -->|"git clone"| GH
    SCS -->|"sonar-scanner CLI<br>+ REST API (poll + fetch issues)"| SQ
    SCS -->|"AI fix-suggestion request"| AI

    %% Styling
    style FE fill:#4CAF50,color:#fff
    style LS fill:#2196F3,color:#fff
    style PS fill:#2196F3,color:#fff
    style SCS fill:#2196F3,color:#fff
    style LDB fill:#FF9800,color:#fff
    style PDB fill:#FF9800,color:#fff
    style SDB fill:#FF9800,color:#fff
    style GH fill:#24292e,color:#fff
    style SQ fill:#9C27B0,color:#fff
    style AI fill:#333,color:#fff
