%%{init: {'theme': 'dark', 'themeVariables': {'lineColor': '#000000', 'edgeLabelBackground': '#ffffff'}}}%%
flowchart LR
    subgraph "Developer"
        Code[Write Code]
        Commit[git commit]
        Push["git push
(add-JWT-config deploys ·
main / feature-sonarCloud scan only)"]
    end

    subgraph "GitHub Actions: sonarcloud-scan"
        SonarCI["📊 SonarCloud Scan
mvn compile × 3 services
+ frontend tests with coverage
Single shared project · monorepo"]
    end

    subgraph "GitHub Actions: snyk-scan (disabled · scan limit)"
        Snyk["🛡️ Snyk Dependency Scan
Matrix: login / project / scan + frontend package.json"]
    end

    subgraph "GitHub Actions: docker-build-push"

        Checkout[Checkout Code<br>actions/checkout@v4]

        subgraph "AWS Auth"
            AWSCreds[Configure AWS Credentials<br>Access Key + Secret Key]
            ECRLogin[Login to Amazon ECR<br>amazon-ecr-login@v2]
        end

        subgraph "Docker Build × 4"
            B1["Build login-service
project-portal-backend/springBoot_login"]
            B2["Build project-service
project-portal-backend/springBoot_project"]
            B3["Build scan-service
project-portal-backend/springBoot_scan"]
            B4["Build frontend
project-portal-frontend (Nginx, /api proxy)"]
        end

        subgraph "Push to ECR (2 tags each)"
            T1["login-latest
login-{sha}"]
            T2["project-latest
project-{sha}"]
            T3["scan-latest
scan-{sha}"]
            T4["frontend-latest
frontend-{sha}"]
        end
    end

    subgraph "AWS ECR (ap-southeast-2)"
        ECR[("📦 nusiss_projectmanagementportal")]
    end

    subgraph "GitHub Actions: deploy-backends (parallel · one job per Auto Scaling Group)"
        SSMPUB["Publish to SSM Parameter Store
/portal/&lt;role&gt;/compose
/portal/image-tag = {sha}"]
        D1["project-portal-login-asg
instance refresh"]
        D2["project-portal-project-asg
instance refresh"]
        D3["project-portal-scan-asg
instance refresh"]
    end

    subgraph "Instance refresh (per group, zero downtime)"
        R1["Launch new instance
boot: read SSM config, pull {sha}"]
        R2["ALB /health passes
+ 120 s warm-up"]
        R3["Terminate old instance"]
    end

    subgraph "GitHub Actions: deploy-web (only if all groups refreshed)"
        DW["web EC2 (SSH)
deploy.sh {sha} · Caddy + frontend
checks HTTPS certificate + each service via the ALB"]
    end

    Code --> Commit --> Push
    Push --> SonarCI
    Push -.-> Snyk
    Push --> Checkout
    Checkout --> AWSCreds --> ECRLogin
    ECRLogin --> B1 & B2 & B3 & B4
    B1 --> T1 --> ECR
    B2 --> T2 --> ECR
    B3 --> T3 --> ECR
    B4 --> T4 --> ECR
    ECR --> SSMPUB
    SSMPUB --> D1 & D2 & D3
    D1 & D2 & D3 -.-> R1
    R1 --> R2 --> R3
    D1 & D2 & D3 --> DW

