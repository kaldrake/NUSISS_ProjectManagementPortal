%%{init: {'theme': 'dark', 'themeVariables': {'lineColor': '#000000', 'edgeLabelBackground': '#ffffff'}}}%%
flowchart TB
    Push["💻 Developer<br>git push to main · pull request to main"]

    subgraph G1["Stage 1 · dependency-scan"]
        Snyk["🛡️ Snyk Open Source (fail fast)<br>login · project · scan pom.xml + frontend package-lock.json<br>--severity-threshold=high --fail-on=upgradable"]
    end

    subgraph G2["Stage 2 · tests"]
        BT["🧪 backend-tests (needs stage 1)<br>matrix × 3: mvn test<br>login · project · scan"]
        FT["🧪 frontend-tests<br>Jest (npm test)"]
        MON["📈 snyk-monitor<br>push only · non-gating<br>snapshot to Snyk dashboard"]
    end

    subgraph G3["Stage 3 · sonarcloud-scan"]
        Sonar["📊 SonarCloud (needs both test jobs)<br>mvn test + JaCoCo, Jest coverage<br>one shared project · wait for quality gate"]
    end

    subgraph G4["Stage 4 · build + push"]
        Build["🐳 docker-build-push (main only)<br>Build 4 images<br>login · project · scan · frontend (Nginx)"]
        ECR[("📦 Amazon ECR · ap-southeast-2<br>nusiss_projectmanagementportal<br>service-latest + service-sha")]
    end

    subgraph G5["Stage 5 · deploy-backends (× 3)"]
        SSM["🗝️ One job per Auto Scaling group<br>Publish to SSM Parameter Store<br>/portal/role/compose · /portal/image-tag = sha"]
        Refresh["♻️ Instance refresh<br>login-asg · project-asg · scan-asg<br>min healthy 100% · max 200% · warm-up 120 s"]
        Health["✅ New instance boots, reads SSM, pulls image<br>internal ALB /health passes, old instance terminated"]
    end

    subgraph G6["Stage 6 · deploy-web"]
        Web["🌐 web EC2 over SSH (needs all three groups)<br>deploy.sh sha · Caddy + frontend<br>checks frontend, HTTPS certificate, each backend via the ALB"]
    end

    Push --> Snyk
    Snyk --> BT
    Snyk --> FT
    Snyk -.-> MON
    BT --> Sonar
    FT --> Sonar
    Sonar --> Build
    Build --> ECR
    ECR --> SSM
    SSM --> Refresh
    Refresh --> Health
    Health --> Web

    style Push fill:#334155,color:#fff
    style Snyk fill:#f59e0b,color:#fff
    style BT fill:#8b5cf6,color:#fff
    style FT fill:#8b5cf6,color:#fff
    style MON fill:#64748b,color:#fff
    style Sonar fill:#0d9488,color:#fff
    style Build fill:#8b5cf6,color:#fff
    style ECR fill:#FF9800,color:#fff
    style SSM fill:#5c6bc0,color:#fff
    style Refresh fill:#0ea5e9,color:#fff
    style Health fill:#0ea5e9,color:#fff
    style Web fill:#10b981,color:#fff
