%%{init: {'theme': 'dark', 'themeVariables': {'lineColor': '#000000', 'edgeLabelBackground': '#ffffff'}}}%%
graph TB
    subgraph "User/Browser"
        User[👤 User]
    end

    subgraph "AWS (ap-southeast-2) · Default VPC"

        subgraph "EC2 #1 web · t3.large · Elastic IP"
            FE["🌐 Frontend + Reverse Proxy
React + TypeScript (Nginx)
Port: 80 (public)
/api/* → backend EC2s"]
            SQ["📊 SonarQube Server
v9.9.5 LTS (Community)
Port: 9001"]
            SQDB[("🐘 sonarqube_db
PostgreSQL 13
Port: 5432 (Docker network only)")]
        end

        subgraph "Backend EC2s · project-portal-backend-sg"
            LS["🔐 Login Service
EC2 #2 · t3.small
Spring Boot 3.5 (Java 17)
Port: 8081"]
            PS["📁 Project Service
EC2 #3 · t3.small
Spring Boot 3.5 (Java 17)
Port: 8082"]
            SCS["🔍 Scan Service
EC2 #4 · t3.medium
Spring Boot 3.5 (Java 17) + sonar-scanner
Port: 8083"]
        end

        subgraph "Amazon RDS · MySQL 8.4 · db.t4g.micro (private, TLS)"
            LDB[("🗄️ login_db
users · sessions")]
            PDB[("🗄️ project_db
projects · repositories")]
            SDB[("🗄️ scan_db
scans · vulnerabilities · ai_suggestions")]
        end

        ECR["📦 Amazon ECR
nusiss_projectmanagementportal
4 images: login / project / scan / frontend"]
    end

    subgraph "External Services"
        GH["🐙 GitHub
Repository Hosting"]
        AI["🤖 AI Suggestion Router (AI_PROVIDER)
DeepSeek (active) · Gemini / Claude (configurable)"]
    end

    %% User to Frontend
    User -->|"HTTP :80"| FE

    %% Nginx reverse proxy to backend EC2s (private IPs)
    FE -->|"/api/auth, /api/login → :8081"| LS
    FE -->|"/api/projects → :8082"| PS
    FE -->|"/api/scans, /api/github → :8083"| SCS

    %% Services to their own databases on RDS
    LS -->|"JDBC (TLS)"| LDB
    PS -->|"JDBC (TLS)"| PDB
    SCS -->|"JDBC (TLS)"| SDB

    %% Service-to-service
    PS -->|"HTTP :8083 (trigger scan, results)"| SCS

    %% Scan Service to SonarQube on the web EC2
    SCS -->|"sonar-scanner CLI → HTTP :9001"| SQ
    SQ -->|"JDBC"| SQDB
    SQ -->|"Scan Results"| SCS

    %% External integrations
    SCS -->|"Git Clone (source code)"| GH
    SCS -->|"REST API (AI suggestions)"| AI

    %% CI/CD deploys images from ECR
    ECR -.->|"docker pull (deployment)"| FE
    ECR -.->|"docker pull (deployment)"| LS
    ECR -.->|"docker pull (deployment)"| PS
    ECR -.->|"docker pull (deployment)"| SCS

    %% Styling
    style FE fill:#4CAF50,color:#fff
    style LS fill:#2196F3,color:#fff
    style PS fill:#2196F3,color:#fff
    style SCS fill:#2196F3,color:#fff
    style LDB fill:#FF9800,color:#fff
    style PDB fill:#FF9800,color:#fff
    style SDB fill:#FF9800,color:#fff
    style SQDB fill:#FF9800,color:#fff
    style SQ fill:#9C27B0,color:#fff
    style ECR fill:#FF9800,color:#fff
    style GH fill:#24292e,color:#fff
    style AI fill:#333,color:#fff
