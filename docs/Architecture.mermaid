%%{init: {'theme': 'default', 'themeVariables': {'lineColor': '#000000', 'edgeLabelBackground': '#ffffff'}}}%%
graph TB
    subgraph "User/Browser"
        User[👤 User]
    end

    subgraph "AWS (ap-southeast-2) · Default VPC"

        subgraph "web EC2 · t3.large · Elastic IP 13.238.251.255"
            CADDY["🔒 Caddy
HTTPS :443 (Let's Encrypt, auto-renew)
:80 → redirect to HTTPS
13-238-251-255.sslip.io"]
            FE["🌐 Frontend + Reverse Proxy
React + TypeScript (Nginx)
/api/* → *.portal.internal"]
            SQ["📊 SonarQube Server
v9.9.5 LTS (Community)
Port: 9001"]
            SQDB[("🐘 sonarqube_db
PostgreSQL 13")]
        end

        DNS["🧭 Route 53 private zone
portal.internal
login / project / scan → internal ALB
web → web EC2"]

        ALB["⚖️ Internal Application Load Balancer
:8081 → login · :8082 → project · :8083 → scan
health check: /health"]

        subgraph "Auto Scaling Groups · 1–3 instances each · target 60% avg CPU"
            LS["🔐 Login Service
project-portal-login-asg · t3.small
Spring Boot 4.1 (Java 17) :8081"]
            PS["📁 Project Service
project-portal-project-asg · t3.small
Spring Boot 4.1 (Java 17) :8082"]
            SCS["🔍 Scan Service
project-portal-scan-asg · t3.medium
Spring Boot 4.1 + sonar-scanner :8083"]
        end

        SSM["🗝️ SSM Parameter Store
/portal/&lt;role&gt;/env (encrypted)
/portal/&lt;role&gt;/compose · /portal/image-tag"]

        subgraph "Amazon RDS · MySQL 8.4 · db.t4g.micro (private, TLS)"
            LDB[("🗄️ login_db
users · sessions")]
            PDB[("🗄️ project_db
projects · repositories")]
            SDB[("🗄️ scan_db
scans · vulnerabilities · ai_suggestions · scan_summary")]
        end

        ECR["📦 Amazon ECR
nusiss_projectmanagementportal
4 images: login / project / scan / frontend"]
    end

    subgraph "External Services"
        GH["🐙 GitHub
Repository Hosting"]
        AI["🤖 AI Suggestion Router (AI_PROVIDER)
Gemini · DeepSeek (in use) · Claude (supported)
second reviewer call scores each fix"]
    end

    %% User to the web EC2
    User -->|"HTTPS :443"| CADDY
    CADDY -->|"HTTP (Docker network)"| FE

    %% Nginx to the services through the internal ALB
    FE -->|"login / project / scan .portal.internal"| ALB
    FE -.->|"name lookup"| DNS
    ALB -->|":8081"| LS
    ALB -->|":8082"| PS
    ALB -->|":8083"| SCS

    %% Service-to-service (through the ALB)
    PS -->|"scan.portal.internal:8083 (trigger scan, results)"| ALB

    %% Services to their own databases on RDS
    LS -->|"JDBC (TLS)"| LDB
    PS -->|"JDBC (TLS)"| PDB
    SCS -->|"JDBC (TLS)"| SDB

    %% Scan Service to SonarQube on the web EC2
    SCS -->|"sonar-scanner → web.portal.internal:9001"| SQ
    SQ -->|"JDBC"| SQDB

    %% External integrations
    SCS -->|"Git Clone (source code)"| GH
    SCS -->|"REST API (AI suggestions + review)"| AI

    %% Instance bootstrap: config + images
    SSM -.->|"config at boot (start.sh)"| LS
    SSM -.->|"config at boot"| PS
    SSM -.->|"config at boot"| SCS
    ECR -.->|"docker pull"| LS
    ECR -.->|"docker pull"| PS
    ECR -.->|"docker pull"| SCS
    ECR -.->|"docker pull"| FE

    %% Styling
    style CADDY fill:#22863a,color:#fff
    style FE fill:#4CAF50,color:#fff
    style ALB fill:#e65100,color:#fff
    style DNS fill:#5c6bc0,color:#fff
    style SSM fill:#5c6bc0,color:#fff
    style LS fill:#2196F3,color:#fff
    style PS fill:#2196F3,color:#fff
    style SCS fill:#2196F3,color:#fff
    style LDB fill:#FF9800,color:#fff
    style PDB fill:#FF9800,color:#fff
    style SDB fill:#FF9800,color:#fff
    style SQDB fill:#FF9800,color:#fff
    style SQ fill:#9C27B0,color:#fff
    style ECR fill:#FF9800,color:#fff
    style GH fill:#24292e,color:#fff
    style AI fill:#333,color:#fff
