%%{init: {'theme': 'dark', 'themeVariables': {'lineColor': '#000000', 'edgeLabelBackground': '#ffffff'}}}%%
flowchart LR

    subgraph "Actors (Personas)"
        PM["👔 Project Manager"]
        TL["🧭 Technical Lead"]
        DSE["🛡️ DevSecOps Engineer"]
        DEV["💻 Developer"]
    end

    PortalUser(("👤 Portal User
(authenticated; owner-only access to own projects)"))

    PM -.->|"is a"| PortalUser
    TL -.->|"is a"| PortalUser
    DSE -.->|"is a"| PortalUser
    DEV -.->|"is a"| PortalUser

    subgraph "NUSISS Project Management Portal"

        subgraph "Account & Auth"
            UC1([Register Account])
            UC2([Log In / Log Out])
        end

        subgraph "Project Management"
            UC3([Create Project])
            UC4([View Projects & Dashboard Summary])
            UC5([Update Project])
            UC6([Delete Project])
        end

        subgraph "Repository Management"
            UC7([Add GitHub Repository])
            UC8([View Repositories])
            UC9([Remove Repository])
        end

        subgraph "Scan Management"
            UC10([Trigger Scan via SonarQube])
        end

        subgraph "Vulnerability Management"
            UC11([View Vulnerabilities])
            UC12(["View Vulnerability Detail & AI Fix Suggestion (generated during scan for Blocker/Critical findings via AI router, Gemini by default)"])
            UC13([Update Vulnerability Status Open / In Progress / Resolved / False Positive])
        end

    end

    PortalUser --- UC1
    PortalUser --- UC2
    PortalUser --- UC3
    PortalUser --- UC4
    PortalUser --- UC5
    PortalUser --- UC6
    PortalUser --- UC7
    PortalUser --- UC8
    PortalUser --- UC9
    PortalUser --- UC10
    PortalUser --- UC11
    PortalUser --- UC12
    PortalUser --- UC13

    
