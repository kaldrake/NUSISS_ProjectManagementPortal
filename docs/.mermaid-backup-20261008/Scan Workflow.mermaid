%%{init: {'theme': 'dark', 'themeVariables': {'lineColor': '#000000', 'actorLineColor': '#000000', 'signalColor': '#000000', 'signalTextColor': '#000000'}}}%%
sequenceDiagram
    actor User
    participant RL as RepositoryList (React)
    participant PSvc as project.service.ts
    participant Ax as projectApi (axios + auth interceptor)
    participant JF as JwtAuthenticationFilter (project-service)
    participant PC as ProjectController
    participant PS as ProjectService
    participant GRR as GitHubRepositoryRepository (JPA)
    participant SC as ScanServiceClient (RestTemplate)
    participant JS as JwtAuthenticationFilter (scan-service)
    participant SCC as ScanController
    participant SS as ScanService
    participant SQS as SonarQubeScannerService
    participant SQ as SonarQube :9001
    participant R as AiSuggestionRouter
    participant G as GeminiService
    participant DB as scandb (MySQL)

    User->>RL: Click "Scan Now"
    RL->>PSvc: triggerScan(projectId, repoId)
    PSvc->>Ax: POST /api/projects/{pid}/repositories/{rid}/scan
    Ax->>JF: Authorization: Bearer JWT

    alt token missing, invalid or expired
        JF-->>Ax: 401 Unauthorized (HttpStatusEntryPoint)
        Ax-->>RL: 401 interceptor clears session, redirects to /login
    else token valid
        JF->>PC: userId claim set as request attribute
        PC->>PS: assertProjectOwner(pid, userId)
        alt caller does not own the project
            PS-->>PC: ResponseStatusException 403
            PC-->>RL: 403 Forbidden
        else caller owns the project
            PC->>PS: triggerScan(pid, rid, jwt) @Async
            PC-->>RL: 202 Accepted (returns immediately)
            RL-->>User: Toast "Scan triggered successfully"
        end
    end

    rect rgb(255, 245, 230)
        Note over PS,SCC: Background thread 1 (project-service) - JWT passed explicitly, request context is not available here
        PS->>GRR: findById(rid)
        GRR-->>PS: GitHubRepository (cloneUrl, defaultBranch)
        PS->>SC: triggerScan(pid, rid, cloneUrl, branch, jwt)
        SC->>JS: POST /api/scans/analyze (Bearer JWT, ScanRequestDTO)
        JS->>SCC: token valid, userId claim set as request attribute
        SCC->>SS: createScan(request, userId)
        SS->>DB: INSERT scans (status PENDING, owner_id = userId)
        SCC->>SS: runScan(scanId, request) @Async
        SCC-->>SC: 202 ACCEPTED (with scanId)
        PS->>GRR: updateLastScanAt(rid) (scanId was returned)
    end

    rect rgb(230, 245, 255)
        Note over SS,DB: Background thread 2 (scan-service), one long @Transactional
        SS->>DB: UPDATE scans SET status SCANNING
        SS->>DB: UPDATE scans SET sonarqube_project_key = project_pid_scan_id
        SS->>SQS: scanRepository(repoUrl, branch, projectKey)
        SQS->>SQS: git clone --depth 1 --single-branch into a private owner-only work folder (scan.workdir), 2 min timeout
        SQS->>SQ: sonar-scanner CLI (ProcessBuilder, -D flags)
        loop up to 30 attempts, 2 s apart
            SQS->>SQ: GET /api/ce/activity?component=projectKey
            SQ-->>SQS: task status IN_PROGRESS (keep polling), SUCCESS (continue) or FAILED (fail the scan at once)
        end
        SQS->>SQ: GET /api/issues/search (types=VULNERABILITY, resolved=false, ps=500)
        SQ-->>SQS: issues JSON
        SQS->>SQS: delete cloned temp directory
        SQS-->>SS: List of SonarQubeIssue
    end

    rect rgb(245, 230, 255)
        Note over SS,DB: Persist results and AI suggestions
        loop each issue
            SS->>DB: INSERT vulnerabilities
            opt severity is BLOCKER or CRITICAL
                SS->>R: generateFixSuggestion(vulnerability)
                R->>G: generateFixSuggestion(vulnerability) - provider chosen by AI_PROVIDER, Gemini by default
                alt Gemini answers
                    G-->>R: AiSuggestionResult (parsed JSON, self-reported confidence)
                else API error, 503 or missing key
                    G-->>R: template fallback (confidence 0.2)
                end
                SS->>DB: INSERT ai_suggestions (model_used, confidence_score)
            end
        end
    end

    rect rgb(230, 255, 230)
        Note over SS,DB: Scan completion
        SS->>DB: INSERT scan_summary (total, blocker, critical, major, minor, info counts)
        SS->>DB: UPDATE scans SET status COMPLETED, completed_at
    end

    alt clone error, scanner failure, failed analysis or analysis timeout
        SS->>DB: UPDATE scans SET status FAILED, error_message, completed_at
        Note over SS,DB: no scan_summary row is written, previous results stay visible
    end
