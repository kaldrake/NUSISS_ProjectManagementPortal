%%{init: {'theme': 'dark', 'themeVariables': {'lineColor': '#000000'}}}%%
classDiagram
    direction LR

    namespace Frontend_React {
        class RepositoryList {
            <<React component>>
            +handleTriggerScan(repoId)
        }
        class ProjectDetailPage {
            <<React component>>
            +fetchProjectData()
        }
        class VulnerabilityList {
            <<React component>>
        }
        class projectService {
            <<TS module>>
            +triggerScan(projectId, repoId)
            +getProject(id)
        }
        class scanService {
            <<TS module>>
            +getVulnerabilitiesByProject(projectId)
            +updateVulnerabilityStatus(id, status)
        }
        class apiClients {
            <<axios instances + interceptors>>
            projectApi
            scanApi
            authInterceptor adds Bearer JWT
            responseInterceptor handles 401
        }
    }

    namespace Project_Service {
        class ProjectJwtFilter {
            <<OncePerRequestFilter>>
            +doFilterInternal()
            sets userId request attribute
        }
        class ProjectController {
            <<RestController>>
            +triggerScan(pid, rid, userId, authorization)
            +getProjectById(id, userId)
        }
        class ProjectService {
            <<Service>>
            +assertProjectOwner(pid, userId)
            +triggerScan(pid, rid, jwt) async
            -requireOwnedProject(pid, userId)
        }
        class ScanServiceClient {
            <<Component>>
            +triggerScan(pid, rid, url, branch, jwt)
            +getVulnerabilitiesByProjectId(pid)
        }
        class ProjectRepository {
            <<JpaRepository>>
        }
        class GitHubRepositoryRepository {
            <<JpaRepository>>
        }
    }

    namespace Scan_Service {
        class ScanJwtFilter {
            <<OncePerRequestFilter>>
            sets userId request attribute
        }
        class ScanController {
            <<RestController>>
            +analyzeRepository(request, userId)
            +getProjectVulnerabilities(projectId, userId)
            +regenerateSuggestion(vulnId, userId)
        }
        class ScanService {
            <<Service>>
            +createScan(request, ownerId)
            +runScan(scanId, request) async, transactional
            +getVulnerabilitiesForProject(projectId, userId)
            +getDashboardSummary(projectId, userId)
            +getScanHistory(repoId, userId)
            -requireOwnedScan(scanId, userId)
            -requireOwnedVulnerability(vulnId, userId)
            -attachAiSuggestion(vuln)
            -finishScan(scan, status, error)
            -saveScanSummary(scanId, issues)
        }
        class SonarQubeScannerService {
            <<Service>>
            +scanRepository(url, branch, key)
            -createScanDirectory()
            -cloneRepository()
            -runSonarScanner()
            -waitForAnalysis()
            -latestTaskStatus()
            -fetchIssues()
        }
        class AiSuggestionRouter {
            <<Service, facade>>
            provider = ai.provider (AI_PROVIDER)
            +generateFixSuggestion(vuln)
            +getModelUsed(result)
        }
        class GeminiService {
            <<Service>>
            default provider
        }
        class DeepSeekService {
            <<Service>>
            selectable with AI_PROVIDER=deepseek
        }
        class ClaudeService {
            <<Service>>
            selectable with AI_PROVIDER=claude
        }
        class FallbackSuggestionTemplates {
            <<utility>>
            +forVulnerability(vuln)
        }
        class AiSuggestionResult {
            suggestionText
            codeExample
            confidenceScore
            usedFallback
        }
        class ScanRepository {
            <<JpaRepository>>
        }
        class VulnerabilityRepository {
            <<JpaRepository>>
            +findLatestByProjectId(pid, ownerId)
        }
        class AiSuggestionRepository {
            <<JpaRepository>>
        }
        class ScanSummaryRepository {
            <<JpaRepository>>
        }
        class Scan {
            <<Entity>>
            projectId
            repositoryId
            scanStatus
            sonarqubeProjectKey
        }
        class Vulnerability {
            <<Entity>>
            severity
            filePath
            lineNumber
            status
        }
        class AiSuggestion {
            <<Entity>>
            confidenceScore
            modelUsed
        }
        class ScanSummary {
            <<Entity>>
            totalVulnerabilities
            blocker, critical, major, minor, info counts
        }
    }

    RepositoryList --> projectService
    ProjectDetailPage --> projectService
    ProjectDetailPage --> scanService
    ProjectDetailPage --> VulnerabilityList
    VulnerabilityList --> scanService
    projectService --> apiClients
    scanService --> apiClients

    apiClients ..> ProjectJwtFilter : HTTP + Bearer JWT
    ProjectJwtFilter --> ProjectController
    ProjectController --> ProjectService
    ProjectService --> ProjectRepository
    ProjectService --> GitHubRepositoryRepository
    ProjectService --> ScanServiceClient

    ScanServiceClient ..> ScanJwtFilter : HTTP RestTemplate + Bearer JWT
    apiClients ..> ScanJwtFilter : HTTP + Bearer JWT
    ScanJwtFilter --> ScanController
    ScanController --> ScanService
    ScanService --> SonarQubeScannerService
    ScanService --> AiSuggestionRouter
    AiSuggestionRouter --> GeminiService : default
    AiSuggestionRouter ..> DeepSeekService : AI_PROVIDER=deepseek
    AiSuggestionRouter ..> ClaudeService : AI_PROVIDER=claude
    GeminiService ..> AiSuggestionResult : creates
    GeminiService ..> FallbackSuggestionTemplates : fallback text
    DeepSeekService ..> FallbackSuggestionTemplates : fallback text
    ClaudeService ..> FallbackSuggestionTemplates : fallback text
    ScanService --> ScanRepository
    ScanService --> VulnerabilityRepository
    ScanService --> AiSuggestionRepository
    ScanService --> ScanSummaryRepository

    Scan "1" --> "0..*" Vulnerability : has
    Vulnerability "1" --> "0..1" AiSuggestion : has
    Scan "1" --> "0..1" ScanSummary : summarised by
