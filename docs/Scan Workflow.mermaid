%%{init: {'sequence': {'wrap': true, 'width': 230, 'actorMargin': 40}, 'theme': 'default', 'themeVariables': {'lineColor': '#000000', 'actorLineColor': '#000000', 'signalColor': '#000000', 'signalTextColor': '#000000'}}}%%
sequenceDiagram
    actor User
    participant FE as Frontend (RepositoryList)
    participant PS as Project Service :8082
    participant SS as Scan Service :8083
    participant SQS as SonarQubeScannerService
    participant SQ as SonarQube :9001
    participant AI as AiSuggestionRouter
    participant LLM as LLM provider (Gemini or DeepSeek)
    participant DB as scan_db (MySQL)

    User->>FE: Click "Scan Now"
    FE->>PS: POST /api/projects/{pid}/repositories/{rid}/scan (Bearer JWT)

    alt token missing, invalid or expired
        PS-->>FE: 401 Unauthorized (HttpStatusEntryPoint)
        FE->>FE: 401 interceptor clears session, redirect to /login
    else token valid
        PS->>PS: assertProjectOwner(pid, userId from JWT)
        alt caller does not own the project
            PS-->>FE: Access denied (ownership rule)
        else caller owns the project
            PS-->>FE: 202 Accepted (returns immediately)
            FE-->>User: Toast "Scan triggered successfully"
        end
    end

    rect rgb(255, 245, 230)
        Note over PS,SS: Background thread 1 (project-service, @Async) - JWT passed explicitly
        PS->>PS: load repository (cloneUrl, defaultBranch)
        PS->>SS: POST /api/scans/analyze (Bearer JWT, ScanRequestDTO)
        SS->>SS: JwtAuthenticationFilter sets userId attribute
        SS->>DB: INSERT scans (status PENDING, owner_id = userId)
        SS-->>PS: 202 ACCEPTED (with scanId)
        PS->>PS: update repository lastScanAt
    end

    rect rgb(230, 245, 255)
        Note over SS,SQ: Background thread 2 (scan-service, @Async runScan, one long @Transactional)
        SS->>DB: UPDATE scans SET status SCANNING, sonarqube_project_key
        SS->>SQS: scanRepository(repoUrl, branch, projectKey)
        SQS->>SQS: git clone --depth 1 into private owner-only folder (scan.workdir), 2 min timeout
        SQS->>SQ: sonar-scanner CLI (-D flags)
        loop up to 30 attempts, 2 s apart
            SQS->>SQ: GET /api/ce/activity?component=projectKey
            SQ-->>SQS: IN_PROGRESS (keep polling), SUCCESS (continue) or FAILED (fail the scan at once)
        end
        SQS->>SQ: GET /api/issues/search (types=VULNERABILITY, resolved=false, ps=500)
        SQ-->>SQS: issues JSON
        SQS->>SQS: delete cloned directory
        SQS-->>SS: List of SonarQubeIssue
    end

    rect rgb(245, 230, 255)
        Note over SS,AI: Persist results and AI suggestions
        loop each issue
            SS->>DB: INSERT vulnerabilities
            opt severity is BLOCKER or CRITICAL
                SS->>AI: generateFixSuggestion(vulnerability)
                AI->>LLM: call 1: generate the fix (provider chosen by AI_PROVIDER)
                alt provider answers with a complete fix
                    LLM-->>AI: explanation, steps, code example, self-reported confidence
                    opt AI_JUDGE_ENABLED = true (default)
                        AI->>LLM: call 2: independent review of the fix (temperature 0)
                        LLM-->>AI: score 0.0 to 1.0
                        AI->>AI: reviewer score replaces the self-reported confidence (kept if the review fails)
                    end
                else API error, 503 or missing key
                    AI->>AI: template fallback (confidence 0.2, model fallback-template, not reviewed)
                end
                AI-->>SS: AiSuggestionResult
                SS->>DB: INSERT ai_suggestions (model_used, confidence_score)
            end
        end
    end

    rect rgb(230, 255, 230)
        Note over SS,DB: Scan completion
        SS->>DB: INSERT scan_summary (total, blocker, critical, major, minor, info counts)
        SS->>DB: UPDATE scans SET status COMPLETED, completed_at
    end

    alt clone error, scanner failure, failed analysis or analysis timeout
        SS->>DB: UPDATE scans SET status FAILED, error_message, completed_at
        Note over SS,DB: no scan_summary row is written, previous results stay visible
    end
